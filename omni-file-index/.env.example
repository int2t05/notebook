# 智谱 GLM（OpenAI 兼容）。在 https://open.bigmodel.cn 申请 key
ZHIPU_API_KEY=your_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 两档模型：bulk 给全量普通文件提炼，key 给重点文件画 mermaid
BULK_MODEL=glm-4-flash
KEY_MODEL=glm-4-plus

# 并发与限速
CONCURRENCY=5

# 可选：覆盖三个项目的父目录（默认 D:/Project/Work）
# OMNI_ROOT=D:/Project/Work
